# Copy to backend/.env and provide a strong secret; never commit the actual file.
POSTGRES_DB=ritim
POSTGRES_USER=ritim
POSTGRES_PASSWORD=replace-with-a-strong-password
API_PORT=3000

# All three OIDC settings are required for authenticated APIs; examples only.
# OIDC_ISSUER=https://identity.example.com/realms/ritim
# OIDC_AUDIENCE=ritim-api
# OIDC_JWKS_URL=https://identity.example.com/realms/ritim/protocol/openid-connect/certs

# Pre-provision distinct database logins; never use the database bootstrap superuser for API or migration.
MIGRATION_DB_USER=replace-with-schema-owner
MIGRATION_DB_PASSWORD=replace-with-migration-password
RUNTIME_DB_USER=replace-with-restricted-runtime
RUNTIME_DB_PASSWORD=replace-with-runtime-password
RITIM_DB_SCHEMA=ritim
